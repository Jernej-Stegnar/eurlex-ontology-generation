_:nc342a7967a364e6a97b33af388605ff6b21 a sh:SPARQLConstraint ;
    sh:message "Individual has no external identifier (owl:sameAs Wikidata or skos:exactMatch authority IRI)." ;
    sh:prefixes eosh: ;
    sh:select """
      SELECT $this WHERE {
        $this eo:entityKind "individual" .
        FILTER NOT EXISTS { $this owl:sameAs ?wd }
        FILTER NOT EXISTS { $this skos:exactMatch ?iri }
      }""" .

_:nc342a7967a364e6a97b33af388605ff6b49 a sh:SPARQLConstraint ;
    sh:message "dateTime constraint whose right operand is not an xsd:date." ;
    sh:prefixes eosh: ;
    sh:select """
      SELECT $this ?value WHERE {
        $this odrl:leftOperand odrl:dateTime ; odrl:rightOperand ?value .
        FILTER (datatype(?value) != <http://www.w3.org/2001/XMLSchema#date>)
      }""" .

_:nc342a7967a364e6a97b33af388605ff6b32 sh:message "Action is outside the controlled vocabulary (no odrl:includedIn parent)." ;
    sh:minCount 1 ;
    sh:path odrl:includedIn ;
    sh:severity sh:Warning .

_:nc342a7967a364e6a97b33af388605ff6b29 a sh:SPARQLConstraint ;
    sh:message "odrl:assignee is not typed Party." ;
    sh:prefixes eosh: ;
    sh:select """
      SELECT $this ?value WHERE {
        $this odrl:assignee ?value .
        FILTER NOT EXISTS { ?value eo:coreType "Party" }
      }""" .

_:nc342a7967a364e6a97b33af388605ff6b30 a sh:SPARQLConstraint ;
    sh:message "odrl:target is a Party; the target is what the action applies to." ;
    sh:prefixes eosh: ;
    sh:select """
      SELECT $this ?value WHERE {
        $this odrl:target ?value .
        ?value eo:coreType "Party" .
      }""" .

_:nc342a7967a364e6a97b33af388605ff6b24 a sh:SPARQLConstraint ;
    sh:message "Entity is not used by any rule or relationship." ;
    sh:prefixes eosh: ;
    sh:select """
      SELECT $this WHERE {
        FILTER NOT EXISTS { ?r odrl:assignee|odrl:assigner|odrl:target $this }
        FILTER NOT EXISTS { $this ?p ?o . ?p a owl:ObjectProperty . ?o eo:entityKind ?k1 }
        FILTER NOT EXISTS { ?s ?p2 $this . ?p2 a owl:ObjectProperty . ?s eo:entityKind ?k2 }
      }""" .

_:nc342a7967a364e6a97b33af388605ff6b50 a sh:SPARQLConstraint ;
    sh:message "Constraint uses the fallback 'condition' operand (free-text condition)." ;
    sh:prefixes eosh: ;
    sh:select """
      SELECT $this WHERE { $this odrl:leftOperand eo:condition . }""" .

