pol:permission_083247d58eeb a odrl:Permission ;
    odrl:action act:calculate ;
    odrl:assignee ent:European_Union ;
    odrl:constraint [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:lteq ;
            odrl:rightOperand "measured by per capita income" ],
        [ a odrl:Constraint ;
            odrl:leftOperand odrl:payAmount ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "added value of the overall Union involvement" ],
        [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:lteq ;
            odrl:rightOperand "as measured by per capita income and poverty ratios" ],
        [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "fair burden sharing between the Union and other donors" ],
        [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "pre-existing deployment of the Union’s other external financing instruments" ],
        [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "at its disposal" ],
        [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:gteq ;
            odrl:rightOperand "expected financial contributions from multilateral donors" ],
        [ a odrl:Constraint ;
            odrl:leftOperand eo:condition ;
            odrl:operator odrl:eq ;
            odrl:rightOperand "capacity to finance itself with its own resources" ] ;
    odrl:target ent:MacroFinancialAssistance ;
    eo:actionLabel "calculate_assistance_amount" ;
    eo:actionObject "assistance_amount" ;
    eo:supportChunks 1 .

